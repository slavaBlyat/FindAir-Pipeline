{
  "name": "rules-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rules-api",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "dotnet build apps/rules-api/RulesApi.csproj --no-restore" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "dotnet run --project apps/rules-api/RulesApi.csproj" }
    }
  },
  "tags": ["type:app", "scope:api", "role:http-api"]
}

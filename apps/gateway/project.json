{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gateway",
  "implicitDependencies": ["rabbit-client"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "dotnet build apps/gateway/Gateway.csproj --no-restore" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "dotnet run --project apps/gateway/Gateway.csproj" }
    }
  },
  "tags": ["type:app", "scope:rabbitmq", "role:publisher"]
}
